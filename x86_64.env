# x86_64.env
# x86_64 devices (e.g. Intel NUC or a spare PC) running balenaOS. Useful as
# a fast build/test target during development, or to add non-ARM capacity
# to the runner fleet alongside the Raspberry Pi boards.

BALENA_ARCH=x86_64
BALENA_MACHINE_NAME=intel-nuc
PLATFORM=linux/amd64
PRIMARY_HUB=ubuntu
PRIMARY_TAG=22.04
RUNNER_ARCH=x64
