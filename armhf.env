# armv7hf.env
# Older / 32-bit Raspberry Pi boards (e.g. Pi 3, Zero 2 W) running balenaOS
# in 32-bit mode. Not the primary target for this project (RAM-limited),
# kept here to demonstrate the multi-arch pattern.

BALENA_ARCH=armv7hf
PLATFORM=linux/arm/v7
PRIMARY_HUB=ubuntu
PRIMARY_TAG=22.04
RUNNER_ARCH=arm
