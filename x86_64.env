# rpi.env
# Original Raspberry Pi / Pi Zero (armv6hf), balena's "rpi" arch slug.
# Weakest boards in the family — listed for template completeness, not
# recommended as an actual CI runner target (too little RAM/CPU for builds).

BALENA_ARCH=x86_64
PLATFORM=linux/amd64
PRIMARY_HUB=ubuntu
PRIMARY_TAG=22.04
RUNNER_ARCH=amd64
