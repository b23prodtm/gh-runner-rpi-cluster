# common.env
# Variables shared across ALL architectures. Values here are overridable
# per-arch in $(BALENA_ARCH).env if a given board ever needs a different
# runner version or extra label.
BALENA_PROJECTS_FLAGS=( PLATFORM BALENA_ARCH BALENA_MACHINE_NAME PRIMARY_HUB )
BALENA_PROJECTS=( ./gh_runner ./balena-storage )
RUNNER_VERSION=2.319.1
RUNNER_LABELS_BASE=self-hosted,balena
